#!/usr/bin/env ruby
# frozen_string_literal: true

# Preserve the repository-local boot path while delegating all behavior to the
# shared runtime dependency-floor implementation.
structuredmerge_gems = File.expand_path("../..", __dir__)
if File.directory?(File.join(structuredmerge_gems, "ast-merge"))
  ENV["K_JEM_TEMPLATING"] ||= "true"
  ENV["STRUCTUREDMERGE_DEV"] ||= structuredmerge_gems
  structuredmerge_root = File.expand_path("../..", structuredmerge_gems)
  kettle_dev_root = File.expand_path("../kettle-dev", structuredmerge_root)
  ENV["KETTLE_DEV_DEV"] ||= kettle_dev_root if File.directory?(kettle_dev_root)
end

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "rubygems"
require "bundler/setup"
require "kettle/deps/floor"

class KettleJemDepsFloor
  DEFAULTS = {
    executable: "kettle-jem-deps-floor",
    project_root: File.expand_path("..", __dir__),
    config_name: ".kettle-jem-deps-floor.yml",
    sources: [
      "lib/kettle/jem/templates/Appraisal.root.gemfile.example",
      "lib/kettle/jem/templates/Appraisals.example",
      "lib/kettle/jem/templates/Gemfile.example",
      "lib/kettle/jem/templates/gem.gemspec.example",
      # Keep ordinary modular bundles (including *_local variants) and their
      # HEAD lanes on automatic floor updates. Nested Ruby-version lanes are
      # curated compatibility matrices; their Gemfile comments and paths are
      # not constraints the generic dependency-floor updater can interpret.
      "lib/kettle/jem/templates/gemfiles/modular/*.gemfile.example",
      "lib/kettle/jem/templates/gemfiles/modular/*/vHEAD.gemfile.example",
      "lib/kettle/jem/templates/shim/Gemfile.example",
      "lib/kettle/jem/templates/shim/gem.gemspec.example",
      "lib/kettle/jem.rb"
    ].freeze,
    changelog_key: "kettle-jem-deps-floor",
    changelog_entry: "Update kettle-jem template dependency floors:",
    placeholder_pattern: "\\{KJ\\|[^}]*\\}"
  }.freeze

  def self.run(argv = ARGV, out: $stdout, err: $stderr)
    Kettle::Deps::Floor::CLI.run(argv, out: out, err: err, defaults: DEFAULTS)
  end
end

exit KettleJemDepsFloor.run if $PROGRAM_NAME == __FILE__
