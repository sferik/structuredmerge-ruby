# frozen_string_literal: true

# Pre-publication CI only. The archive is verified and installed before Bundler.
# Published-registry installation is a separate release gate.
gem_directory = ENV.fetch('STRUCTUREDMERGE_CI_GEM_DIR')
eval_gemfile File.join(gem_directory, 'Gemfile')

if ENV.fetch('STRUCTUREDMERGE_CI_DEP_HEADS', 'false') == 'true'
  runtime_heads = File.join(gem_directory, 'gemfiles/modular/runtime_heads.gemfile')
  head_names = Bundler::Dsl.new.tap { |dsl| dsl.eval_gemfile(runtime_heads) }.dependencies.map(&:name)
  instance_variable_get(:@dependencies).reject! { |dependency| head_names.include?(dependency.name) }
  eval_gemfile runtime_heads
end

# Core is always the exact installed artifact, never a runtime-head substitution.
raise 'Prototype dependency is forbidden in typed-core CI' if dependencies.any? { |dependency| dependency.name == 'structuredmerge_host_prototype' }
instance_variable_get(:@dependencies).reject! { |dependency| dependency.name == 'structuredmerge-core' }
gem 'structuredmerge-core', "= #{ENV.fetch('STRUCTUREDMERGE_CORE_VERSION')}"

# Lockstep family gems: when STRUCTUREDMERGE_DEV is set, replace exact-version
# dependencies with local workspace paths so the pre-publication artifact tests
# against the same in-progress versions that the artifact was built from.
if ENV.fetch('STRUCTUREDMERGE_DEV', '').strip != ''
  structuredmerge_dev_root = ENV.fetch('STRUCTUREDMERGE_DEV')
  lockstep_gems = %w[ast-merge tree_haver ast-crispr ast-crispr-markdown-markly
                     ast-crispr-ruby-prism ast-crispr-toml ast-crispr-yaml-psych
                     ast-template version_gem]
  lockstep_gems.each do |gem_name|
    gem_path = File.join(structuredmerge_dev_root, gem_name)
    if File.directory?(gem_path) && File.exist?(File.join(gem_path, "#{gem_name}.gemspec"))
      instance_variable_get(:@dependencies).reject! { |dependency| dependency.name == gem_name }
      gem gem_name, path: gem_path
    end
  end
end

# Prevent the registry version_gem 1.1.15 from being resolved alongside 1.1.16
# when registry development gems (kettle-dev, kettle-family, kettle-test) with
# the older floor are present. The local structuredmerge gems require >= 1.1.16.
if dependencies.any? { |dependency| dependency.name == "version_gem" }
  instance_variable_get(:@dependencies).reject! { |dependency| dependency.name == "version_gem" }
  gem "version_gem", "~> 1.1", ">= 1.1.16"
end
